{
  "name": "@genocode/agent",
  "version": "0.2.0",
  "description": "Design GenoCode creatures with Claude, or learn to write them: an MCP server with tools to check, draw and save creatures, the genocode-creatures and genocode-tutor skills, and an agent for the Claude API.",
  "keywords": [
    "genocode",
    "creatures",
    "generative art",
    "mcp",
    "claude",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genocode-org/GenoCode-agent.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/genocode-org/GenoCode-agent#readme",
  "bugs": "https://github.com/genocode-org/GenoCode-agent/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "genocode-mcp": "./dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "skill",
    "tutor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "node scripts/copy-skill.mjs",
    "postpack": "node scripts/remove-skill.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@genocode/core": "0.11.10",
    "@genocode/render": "0.13.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
