+  flat_2 = hsv(249.5, 0.97, 0.47)
+  flat_3 = hsv(120.3, 0.21, 0.94)
+  flat_4 = hsv(159.5, 0.45, 0.87)
+  flat_gaps = (0.4711, 0.5315, 0.685)
+  upright_2 = hsv(228.4, 0.75, 1)
+  upright_3 = hsv(223.4, 0.59, 1)
+  upright_4 = hsv(357.7, 0.75, 1)
+  upright_gaps = (0.7178, 0.3008, 0.6523)
+}
+
+variant member_4 {
+  twist = -21.25
+  twist_waves = 1.631
+  twist_start = -0.9434
+  rise = 18.76
+  rise_waves = 3.341
+  rise_start = 0.02778
+  sway = 8.318
+  sway_waves = 3.263
+  sway_start = -0.07877
+  swell = (-0.2262, 0.0357, 0.3958)
+  swell_waves = (17.87, 17.76, 13.32)
+  swell_start = (0.7625, -0.1508, 0.7646)
+  flat_1 = hsv(166.3, 0.97, 0.8)
+  flat_2 = hsv(30.4, 0.84, 0.43)
+  flat_3 = hsv(80.8, 0.84, 0.43)
