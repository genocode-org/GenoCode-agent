diff --git a/plugin/skills/genocode-tutor/examples/Oak.genie b/plugin/skills/genocode-tutor/examples/Oak.genie
new file mode 100644
index 0000000..9aa6a7a
--- /dev/null
+++ b/plugin/skills/genocode-tutor/examples/Oak.genie
@@ -0,0 +1,334 @@
+creature Oak
+// A tree grown the way real trees grow, to show what GenoCode can build in 3D. The trunk and every
+// branch are smooth tapering strokes; side branches spiral out along each limb, four levels down to
+// the twigs, curving up towards the light. Each twig carries its own leaves, every one placed,
+// angled and coloured on its own, and they flutter in the wind. Buttress roots flare out where the
+// trunk meets the ground.
+// The creature itself is an old oak in summer, and its variants are the same tree through the year
+// and other kinds of tree, so it morphs from one to the next: a maple in autumn, the oak bare in
+// winter, a cherry in blossom, a silver birch and a weeping willow.
+
+gene height = 4.5 in 2..8 // how tall the trunk is, up to where its first big limb grows
+gene girth = 0.9 in 0.3..2 // how thick the trunk is at the foot
+gene lean = 4 in 0..25 // how far the trunk leans, in degrees
+gene gnarl = 0.6 in 0..1.5 // how crooked the trunk and branches are
+gene limb_length = 4 in 1.5..6 // how long the big limbs are
+gene reach = 0.62 in 0.4..0.9 // each level of branches' length compared with the one it grows from
+gene spread = 48 in 15..80 // how far each branch leans out from the one it grows from, in degrees
+gene lift = 12 in -30..60 // how much the branches curve up towards the light, or droop if below 0
+gene droop = 0 in 0..170 // how far the thinnest twigs hang down, in degrees, like a weeping willow
+gene twig_length = 1 in 0.5..4 // how long the twigs are, compared with the branches they grow from
+gene roots = 1 in 0.3..2 // how big the roots flaring out at the foot of the trunk are
+gene wind = 0.4 in 0..1 // how much the branches sway and the leaves flutter
+
+gene leaf_size = 0.6 in 0..1 // how long each leaf is; 0 leaves the tree bare
+gene leaf_width = 0.55 in 0.15..1 // how wide each leaf is for its length
+gene leaf_spread = 25 in 0..120 // how far the leaves' colours vary round the colour wheel, in degrees
+gene blossom = 0 in 0..1 // how big the flowers on the twigs are
+gene fallen = 0 in 0..1 // how big the fallen leaves on the ground are
+
+gene bark_colour = hsv(30, 0.35, 0.35) in hsv(0, 0, 0.1)..hsv(360, 1, 1)
+gene leaf_colour = hsv(110, 0.65, 0.5) in hsv(0, 0, 0.1)..hsv(360, 1, 1)
+gene blossom_colour = hsv(335, 0.3, 1) in hsv(0, 0, 0.5)..hsv(360, 1, 1)
+gene ground_colour = hsv(95, 0.45, 0.3) in hsv(0, 0, 0.1)..hsv(360, 1, 1)
+
+// Music stirs the wind: the high notes make the leaves flutter more.
+let breeze = wind + 0.6 * music.high
+
+shine 0.25
+sharpness 0.4
+
+branch {
+  move (0, 0.55 * (height + limb_length), 0)
+  focuspoint
+}
+ground
+repeat 7 as i {
+  branch {
+    yaw 360 * i / 7 + 20 * noise(i * 1.9)
+    root(i)
+  }
+}
+move (0, -0.6, 0) // the trunk starts under the ground
+pitch -90 // pointing up
+trunk
+
+// Turns the turtle's heading by a towards straight up (or, if a is negative, towards straight
+// down), round the axis square to both. It stops at straight up or down rather than going past.
+part bend_up(a) {
+  let axis = cross(turtle.heading, y_axis)
+  let h = clamp(turtle.heading.y, -1, 1)
+  if length(axis) > 0.001 {
+    rotate clamp(a, -acos(-h), acos(h)) around local(normalize(axis))
+  }
+}
+
+// A direction in the world, written in the turtle's own axes, for `rotate … around`.
+function local(v) {
+  return (dot(v, turtle.side), dot(v, turtle.up), dot(v, turtle.heading))
+}
+
+// The ground the tree stands on: a low mound, with fallen leaves lying on it.
+part ground {
+  let wide = 7 + 3 * girth
+  colour ground_colour
+  texture pattern(cells, ground_colour.hue, 4, analogous, satin)
+  wear 0.12
+  lay { move (0, -0.25, 0); grow (wide, 0.5, wide) }
+  texture none
+  repeat 40 as i {
+    branch {
+      yaw 360 * frac(i * golden)
+      let r = wide / 2 * (0.25 + 0.65 * frac(i * 0.37 + 0.2))
+      // On the mound's surface, a little above it.
+      move (0, 0.25 * sqrt(1 - (2 * r / wide) ^ 2) - 0.25 + 0.02, r)
+      yaw 360 * frac(i * 0.71)
+      roll 8 * noise(i * 3.1)
+      let hue = leaf_colour.hue + leaf_spread * noise(i * 0.43) - 10
+      colour hsv(hue, leaf_colour.sat * 0.9, leaf_colour.val * 0.75)
+      lay { grow (leaf_width * 0.5, 0.03, 0.5) * fallen }
+    }
+  }
+}
+
+// A buttress root: tall and thin where it leaves the trunk, flaring out and down into the ground.
+part root(i) {
+  let big = roots * girth
+  move (0, 0.7 * big, 0)
+  pitch 28 // out and down
+  colour mix(bark_colour, black, 0.25)
+  stroke {
+    repeat 5 as k {
+      let t = k / 4
+      lay { grow (0.3 * big * mix(1, 0.4, t), 0.9 * big * mix(1, 0.25, t), 1) }
+      forward 0.4 * big
+      pitch 9
+      yaw 14 * gnarl * noise(i * 2.1 + k * 0.5)
+    }
+  }
+}
+
+// The trunk, rising from under the ground; its big limbs spiral out from its top part, and its
+// leader carries on up into the crown.
+part trunk {
+  let steps = 8
+  pitch lean
+  branch {
+    stroke {
+      for k from 0 to steps {
+        let t = k / steps
+        colour mix(mix(bark_colour, black, 0.3), bark_colour, smoothmix(0, 1, t / 0.4))
+        lay { grow girth * trunk_width(t) }
+        if k < steps {
+          forward height / steps
+          trunk_bend(k)
+        }
+      }
+    }
+  }
+  colour bark_colour
+  for k from 1 to steps {
+    forward height / steps
+    trunk_bend(k - 1)
+    if k >= steps - 3 {
+      branch {
+        roll 137.5 * k + 40
+        pitch spread * mix(1, 0.25, clamp(k - steps + 1, 0, 1)) // the leader at the top grows almost straight up
+        limb(1, limb_length, 0.55 * girth * trunk_width(k / steps), k)
+      }
+    }
+  }
+}
+
+// How wide the trunk is, from its foot (0) to its top (1): flared at the foot, narrowing upwards.
+function trunk_width(t) {
+  return mix(1, 0.5, t) * (1 + 0.5 * (1 - smoothmix(0, 1, t / 0.25)))
+}
+
+part trunk_bend(k) {
+  yaw 8 * gnarl * noise(k * 0.6 + 1.3) + breeze * 0.6 * wave(time / 6) * k / 8
+  pitch 8 * gnarl * noise(k * 0.6 + 7.1)
+}
+
+// A branch: one smooth stroke, tapering to its tip, with side branches spiralling out along it.
+// Level 1 are the big limbs and level 3 the twigs, which carry the leaves and flowers. id tells
+// the branches apart, so each one bends its own way.
+part limb(level, long, thick, id) {
+  let steps = 5
+  // The wind sways every branch a little, so the twigs move the most.
+  yaw breeze * 2.5 * level * wave(time / 5 + id * 0.13)
+  colour mix(bark_colour, white, 0.05 * level)
+  branch {
+    stroke {
+      for k from 0 to steps {
+        lay { grow thick * mix(1, 0.4, k / steps) }
+        if k < steps {
+          forward pace(long / steps)
+          limb_bend(level, id, k)
+        }
+      }
+    }
+  }
+  // Walk the same path again, laying what grows from it.
+  for k from 1 to steps {
+    forward pace(long / steps)
+    limb_bend(level, id, k - 1)
+    if level < 3 {
+      if k >= 2 {
+        branch {
+          roll 137.5 * k + 50 * id
+          pitch spread
+          let twig = clamp(level - 1, 0, 1) // 1 when the new branch is a twig
+          let next = long * reach * mix(1.2, 0.7, k / steps) * mix(1, twig_length, twig)
+          limb(level + 1, next, 0.75 * thick * mix(1, 0.4, k / steps), id * 7 + k)
+        }
+      }
+    } else {
+      repeat 3 as j {
+        leaf(id, 3 * k + j)
+      }
+      if k == 2 or k == 5 {
+        flower(id, k)
+      }
+    }
+  }
+  if level == 3 {
+    leaf(id, 0)
+  }
+}
+
+// A step along a branch, shortened as it nears the ground, so hanging twigs stop just above it.
+function pace(d) {
+  return d * clamp((turtle.position.y - 0.2) / 0.8, 0.03, 1)
+}
+
+// One step's turn along a branch: a little crookedness, a curve up towards the light, and on the
+// thinner branches the droop.
+part limb_bend(level, id, k) {
+  let hang = droop * clamp((level - 1.7) / 1.3, 0, 1)
+  bend_up((lift - hang) / 5)
+  yaw 9 * gnarl * noise(id * 1.7 + k * 0.6)
+  pitch 9 * gnarl * noise(id * 2.3 + k * 0.6 + 4)
+}
+
+// A leaf on a short stalk, tilted out from the twig and turned up towards the light, fluttering.
+part leaf(id, j) {
+  branch {
+    roll 137.5 * j + 40 * noise(id * 0.7 + j)
+    pitch 50
+    bend_up(25)
+    roll breeze * 25 * wave(time / 1.3 + id * 0.31 + j * 0.17)
+    let hue = leaf_colour.hue + leaf_spread * noise(id * 0.31 + j * 0.53)
+    colour hsv(hue, leaf_colour.sat, leaf_colour.val * (0.8 + 0.4 * frac(j * golden + id * 0.13)))
+    let s = leaf_size * (0.85 + 0.3 * noise(id + j * 1.3))
+    lay { forward 0.55 * s; grow (leaf_width * s, 0.05 * s, s) }
+  }
+}
+
+// A flower of five petals round a yellow middle, facing up and out.
+part flower(id, k) {
+  branch {
+    roll 137.5 * k + 90 + 30 * noise(id + k)
+    pitch 60
+    forward 0.08
+    bend_up(50)
+    colour blossom_colour
+    repeat 5 as p {
+      branch {
+        roll 72 * p + 20 * id
+        pitch 70
+        lay { forward 0.13 * blossom; grow (0.17, 0.03, 0.26) * blossom }
+      }
+    }
+    colour mix(blossom_colour, hsv(50, 0.8, 1), 0.6)
+    lay { grow 0.08 * blossom }
+  }
+}
+
+background {
+  fill gradient(hsv(200, 0.45, 0.35), hsv(225, 0.5, 0.18), hsv(250, 0.6, 0.07))
+}
+
+// Its own dance, calm like a tree in a breeze: the music grows it slowly from one tree to the
+// next, and the bass breathes it nearer. It turns round its trunk and never tips over.
+dance {
+  gene growth = 0.25 in 0.05..1 // how many kinds of tree a second the music carries it through
+
+  morph follows music.level speed growth settle 5
+  zoom follows music.bass amount 0.25 settle 6
+  spin follows music.level from 4 to 24 smooth 3 upright
+  turn on music.mid changes by 1
+  reverse on music.high drops by 0.5 on 8 off 16
+}
+
+// A maple in autumn: red and orange leaves, and more of them fallen on the ground.
+variant Maple {
+  height = 3.8
+  girth = 0.75
+  spread = 55
+  lift = 18
+  leaf_width = 0.8
+  leaf_spread = 45
+  fallen = 1
+  leaf_colour = hsv(12, 0.85, 0.8)
+  bark_colour = hsv(20, 0.25, 0.3)
+  ground_colour = hsv(40, 0.45, 0.3)
+}
+
+// The oak bare in winter, standing in snow.
+variant Winter {
+  leaf_size = 0
+  bark_colour = hsv(25, 0.15, 0.3)
+  ground_colour = hsv(210, 0.06, 0.9)
+}
+
+// A cherry in blossom: a leaning trunk, branches spreading out flat, and pink flowers before the
+// leaves are out.
+variant Cherry {
+  height = 3
+  girth = 0.7
+  lean = 15
+  gnarl = 1
+  spread = 62
+  lift = 4
+  leaf_size = 0.18
+  blossom = 1
+  bark_colour = hsv(8, 0.35, 0.25)
+  leaf_colour = hsv(95, 0.6, 0.6)
+  ground_colour = hsv(110, 0.4, 0.35)
+}
+
+// A silver birch: tall and slender with white bark, and small leaves on twigs that hang a little.
+variant Birch {
+  height = 6
+  girth = 0.45
+  lean = 2
+  gnarl = 0.3
+  limb_length = 3
+  spread = 32
+  lift = 22
+  droop = 40
+  roots = 0.6
+  leaf_size = 0.3
+  leaf_width = 0.7
+  leaf_colour = hsv(80, 0.7, 0.65)
+  bark_colour = hsv(40, 0.05, 0.85)
+}
+
+// A weeping willow: its limbs arch up and out, and its long twigs of narrow leaves hang down.
+variant Willow {
+  height = 3.2
+  girth = 1
+  gnarl = 0.5
+  limb_length = 3.5
+  reach = 0.75
+  spread = 45
+  lift = 25
+  droop = 160
+  twig_length = 3.2
+  leaf_size = 0.5
+  leaf_width = 0.18
+  leaf_spread = 15
+  leaf_colour = hsv(75, 0.6, 0.7)
+  bark_colour = hsv(35, 0.3, 0.4)
+}
diff --git a/plugin/skills/genocode-tutor/examples/Peacock.genie b/plugin/skills/genocode-tutor/examples/Peacock.genie
new file mode 100644
index 0000000..8a88dd4
--- /dev/null
+++ b/plugin/skills/genocode-tutor/examples/Peacock.genie
@@ -0,0 +1,636 @@
+creature Peacock
+// A display bird made from shapes: a fan tail of eyed feathers, a scaled breast, a beaded neck and a
+// crown of plumes. When music plays it dances its courtship display: it bounces on the beat, bobs
+// its head, sways, spreads its fan with the bass and makes the whole fan shiver on the high notes.
+// Without music it opens and folds its fan slowly and bobs on its own. Its variants are other
+// display birds: a white peacock, a wild turkey, a golden pheasant and a firebird.
+// Made by Claude for GenoCode.
+
+// The fan
+gene feathers = 21 in 9..31 step 1 // how many feathers in each row of the fan
+gene rows = 3 in 1..4 step 1 // how many rows of feathers, each shorter and in front of the last
+gene train = 5.5 in 2..9 // how long the longest feathers are
+gene fan = 190 in 40..240 // how far round the fan spreads when it's fully open, in degrees
+gene lean = 12 in 0..80 // how far back the open fan leans
+gene vane = 0.22 in 0.08..0.45 // how wide each feather is, compared with its length
+gene eye = 0.75 in 0..1.2 // how big the eye on each feather is
+gene bands = 0 in 0..8 // how many dark bands cross each feather
+gene base = hsv(110, 0.7, 0.42) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the colour near each feather's root
+gene tip = hsv(88, 0.75, 0.58) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the colour at each feather's end
+gene band_colour = hsv(30, 0.6, 0.25) in hsv(0, 0, 0)..hsv(360, 1, 1)
+gene eye_rim = hsv(48, 0.85, 0.9) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the outer ring of each eye
+gene eye_ring = hsv(175, 0.8, 0.8) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the middle ring of each eye
+gene eye_heart = hsv(232, 0.9, 0.45) in hsv(0, 0, 0)..hsv(360, 1, 1) // the middle of each eye
+gene under = hsv(30, 0.35, 0.32) in hsv(0, 0, 0.1)..hsv(360, 1, 1) // the backs of the fan's feathers
+gene quill = hsv(40, 0.1, 0.9) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the feathers' shafts, which show from behind
+gene tail_colour = hsv(30, 0.1, 0.5) in hsv(0, 0, 0.1)..hsv(360, 1, 1) // the stiff tail behind the fan, which holds it up
+
+// The bird
+gene plumage = hsv(212, 0.85, 0.8) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the breast and neck
+gene shimmer = 25 in 0..90 // how far the plumage's colour plays across the scales
+gene bulk = 1 in 0.7..1.4 // how big the body is
+gene scale_size = 0.3 in 0.15..0.5 // how big the scales on the breast are
+gene neck = 2.3 in 1..3.5 // how long the neck is
+gene wing = hsv(32, 0.5, 0.55) in hsv(0, 0, 0.2)..hsv(360, 1, 1) // the folded wings
+gene wing_bars = 0.6 in 0..1 // how strongly the wings are barred
+gene primaries = hsv(20, 0.75, 0.55) in hsv(0, 0, 0.1)..hsv(360, 1, 1) // the long feathers at the wings' ends
+gene mantle = hsv(25, 0.45, 0.22) in hsv(0, 0, 0.1)..hsv(360, 1, 1) // the back
+gene face = hsv(0, 0, 0.95) in hsv(0, 0, 0)..hsv(360, 1, 1) // the bare skin round the eyes
+gene wattle = 0 in 0..1 // how big the red flap under the beak is
+gene crest = 0.9 in 0..1.6 // how tall the crown of plumes is
+gene crest_lean = 10 in 0..80 // how far back the crown lies
+gene crest_colour = hsv(215, 0.85, 0.85) in hsv(0, 0, 0.2)..hsv(360, 1, 1)
+gene legs = hsv(30, 0.12, 0.45) in hsv(0, 0, 0.2)..hsv(360, 1, 1)
+gene grass = 0.7 in 0..1.5 // how tall the grass round its feet is
+
+// The dance
+gene dip = 0.35 in 0..0.8 // how far it dips on each beat
+gene bob = 22 in 0..45 // how far the head bobs forward on each beat
+gene sway = 18 in 0..40 // how far it sways from side to side
+gene sway_time = 3.2 in 1..8 // how many seconds one sway takes
+gene show = 50 in 0..80 // how far it turns left and right to show off its fan; it never turns its back to you
+gene show_time = 12 in 4..30 // how many seconds it takes to turn one way and back
+gene shiver = 9 in 0..20 // how hard the fan shivers on the high notes
+gene flare = 0.25 in 0..0.6 // how much wider the fan spreads with the bass
+gene own_beat = 0.8 in 0.4..2 // seconds between bobs when no music is playing
+gene display_time = 9 in 4..20 // seconds the fan takes to fold and open again without music
+
+// How the music moves it. It slides between its own slow display and the music's beat as the
+// music starts and stops.
+let playing = clamp(music.level * 5, 0, 1)
+let kick = mix(hop(frac(time / own_beat)) * 0.4, hop(beat) * mix(0.5, 1, clamp(music.bass * 1.5, 0, 1)), playing)
+let open = mix(0.55 + 0.45 * cos(360 * time / display_time), clamp(0.85 + flare * music.bass, 0, 1.3), playing)
+let rattle = mix(0.15, 0.3 + music.high_hit, playing) * shiver
+let drop = dip * kick
+let height = 2.2 * bulk // where the middle of the body is at rest
+
+// The camera looks at the focus point, so it goes in the middle of the whole bird at rest: halfway
+// between the feet and the top of the fan or head, and between the beak and the end of the tail.
+// It leaves out the music, so the bird dances round a steady point.
+branch {
+  let fan_top = height + 0.35 * bulk + train * cos(lean)
+  let head_top = height + (0.55 + neck * 0.9) * bulk + max(crest, 0.4) * bulk
+  let tail_end = -0.9 * bulk - train * sin(lean)
+  move (0, max(fan_top, head_top) / 2, (1.6 * bulk + tail_end) / 2)
+  focuspoint
+}
+
+// It turns itself to show off, left and right, but never so far that its back faces the viewer:
+// its dance has no spin, so this is the only turning it does
+yaw clamp(show * wave(time / show_time) + sway * wave(time / sway_time) * mix(0.4, 1, playing), -85, 85)
+
+// The grass it stands on
+branch {
+  grass_tuft
+}
+
+// Legs and feet
+symmetric x {
+  leg(height - drop)
+}
+
+// Everything above the legs rises and dips with the beat
+move (0, height - drop, 0)
+
+// The fan, behind the body
+branch {
+  move (0, 0.35 * bulk, -0.9 * bulk)
+  pitch -90 // the heading points up; the turtle's up now points back, away from the viewer
+  pitch -mix(80, lean, clamp(open, 0, 1))
+  roll rattle * 0.15 * wave(time * 7)
+  repeat rows as r {
+    branch {
+      move (0, -0.06 * r, 0) // each row lies in front of the one before
+      let size = train * (1 - 0.18 * r)
+      let reach = min(fan * open, 230) * (1 - 0.06 * r) // never past a full fan
+      repeat feathers as k {
+        branch {
+          let u = (k + 0.5 * (r % 2)) / feathers
+          yaw (u - 0.5) * reach
+          yaw rattle * 0.45 * wave(time * 9 + k * 0.37 + r * 0.25)
+          feather(size, u)
+        }
+      }
+    }
+  }
+
+  // the stiff tail behind the train, which holds it up
+  branch {
+    move (0, 0.1 * bulk, 0)
+    let reach = min(fan * open, 230) * 0.7
+    repeat 15 as k {
+      branch {
+        yaw (k / 14 - 0.5) * reach
+        yaw rattle * 0.2 * wave(time * 9 + k * 0.29)
+        tail_feather(train * 0.42)
+      }
+    }
+  }
+
+  // a puff of white down where the feathers meet
+  down_tuft
+}
+
+body
+
+// The neck and head
+branch {
+  move (0, 0.55 * bulk, 0.75 * bulk)
+  pitch -82
+  neck_and_head
+}
+
+// The folded wings, which droop and quiver as the fan opens
+symmetric x {
+  branch {
+    move (0.7 * bulk, 0.05 * bulk, -0.1 * bulk)
+    roll -clamp(open, 0, 1) * 18 - rattle * 0.4 * wave(time * 6)
+    pitch 12
+    folded_wing
+  }
+}
+
+// One feather of the fan: a shaft, a vane of overlapping barbs that widens to a teardrop, and an
+// eye near the end. The turtle's heading points along the feather and its up axis away from the
+// viewer, so flattened shapes face the front. Each feather has two sides: the coloured front, and
+// a dull back with the pale shaft running down it, as a real peacock's train has.
+part feather(size, u) {
+  let w = vane * size
+  shape tube
+  colour quill
+  shine 0.1
+  branch {
+    move (0, 0.03, 0)
+    forward size * 0.5
+    lay { grow (0.022, 0.022, size) }
+  }
+
+  // the vane
+  // A flat shape has one normal all over, so a highlight would light the whole face up at once,
+  // white, whenever it turns to the light. The flat parts of a feather don't shine.
+  shape ball
+  shine 0
+  sharpness 0
+  repeat 9 as j {
+    let s = 0.34 + 0.66 * (j + 0.5) / 9
+    let width = w * bump(clamp((s - 0.3) / 0.74, 0, 1)) ^ 0.7
+    let stripe = clamp(wave(s * bands + 0.25) * 2 - 0.6, 0, 1) * clamp(bands, 0, 1)
+    let hue_play = shimmer * 0.3 * wave(u * 2 + s - time * 0.15)
+    let c = mix(base, tip, s)
+    colour mix(hsv(c.hue + hue_play, c.sat, c.val), band_colour, stripe)
+    branch {
+      forward size * s
+      move (0, -0.002 * j, 0)
+      lay { grow (width, 0.025, size * 0.17) }
+      // the back, a little narrower so the front's edge hides it from the front
+      colour mix(mix(under, c, 0.12), band_colour, stripe * 0.6)
+      move (0, 0.022, 0)
+      lay { grow (width * 0.96, 0.025, size * 0.165) }
+    }
+  }
+
+  // the eye: rings laid one in front of another
+  branch {
+    forward size * 0.84
+    let e = eye * w
+    shine 0.04
+    sharpness 0
+    eye_disc(e, eye_rim, 0)
+    eye_disc(e * 0.78, mix(eye_rim, eye_ring, 0.5), 1)
+    eye_disc(e * 0.6, eye_ring, 2)
+    eye_disc(e * 0.4, eye_heart, 3)
+    // the heart's highlight
+    eye_disc(e * 0.12, mix(eye_heart, white, 0.35), 4)
+  }
+}
+
+// One of the stiff tail feathers behind the train: plain, with a pale shaft and a paler edge
+part tail_feather(size) {
+  shape tube
+  colour quill
+  shine 0.1
+  branch {
+    move (0, 0.02, 0)
+    forward size * 0.5
+    lay { grow (0.025, 0.025, size) }
+  }
+  shape ball
+  shine 0
+  sharpness 0
+  repeat 6 as j {
+    let s = 0.2 + 0.8 * (j + 0.5) / 6
+    branch {
+      forward size * s
+      colour mix(tail_colour, quill, 0.25 * s)
+      lay { grow (size * 0.17 * (0.6 + 0.4 * s), 0.03, size * 0.22) }
+    }
+  }
+}
+
+// White down where the feathers of the fan meet, on its back
+part down_tuft {
+  shape ball
+  shine 0
+  sharpness 0
+  repeat 16 as k {
+    branch {
+      yaw -80 + 160 * frac(k * 0.618)
+      forward bulk * (0.15 + 0.45 * frac(k * 0.414))
+      move (0, 0.18 * bulk, 0)
+      colour hsv(40, 0.05, 0.9 + 0.08 * frac(k * 0.31))
+      lay { grow (0.32, 0.22, 0.32) * bulk }
+    }
+  }
+}
+
+part eye_disc(e, c, layer) {
+  colour c
+  branch {
+    move (0, -0.03 - 0.025 * layer, -e * 0.06 * layer)
+    lay { grow (e, 0.025, e * 1.25) }
+  }
+}
+
+// The body, covered in scales on its breast and sides
+part body {
+  shape ball
+  colour plumage
+  shine 0.6
+  sharpness 0.5
+  branch {
+    pitch -12
+    lay { grow (1.5 * bulk, 1.6 * bulk, 2.1 * bulk) }
+  }
+  // the back half in its own darker colour: a slightly smaller egg pushed backwards
+  branch {
+    pitch -12
+    back 0.2 * bulk
+    colour mantle
+    lay { grow (1.46 * bulk, 1.56 * bulk, 1.85 * bulk) }
+  }
+  // rows of overlapping scales over the front half
+  repeat 7 as row {
+    let up = -45 + 15 * row
+    let across = 9 - abs(row - 3)
+    repeat across as k {
+      branch {
+        let round_by = (k - (across - 1) / 2) * 17
+        yaw round_by
+        pitch -up
+        let out = surface(round_by, up)
+        let c = plumage
+        colour hsv(c.hue + shimmer * wave(row * 0.13 + k * 0.07 - time * 0.2), c.sat, c.val * (0.85 + 0.15 * cos(up)))
+        forward out * 0.97 * bulk
+        lay { grow (scale_size * bulk, scale_size * bulk, scale_size * 0.35 * bulk) }
+      }
+    }
+  }
+  // and the back, in its own darker colour
+  repeat 7 as row {
+    let up = -50 + 15 * row
+    let across = 9 - abs(row - 3)
+    repeat across as k {
+      branch {
+        let round_by = 180 + (k - (across - 1) / 2) * 17
+        yaw round_by
+        pitch -up
+        let out = surface(round_by, up)
+        colour hsv(mantle.hue + 6 * wave(row * 0.21 + k * 0.13), mantle.sat, mantle.val * (0.85 + 0.25 * frac(k * 0.37 + row * 0.5)))
+        forward out * 0.97 * bulk
+        lay { grow (scale_size * bulk, scale_size * bulk, scale_size * 0.35 * bulk) }
+      }
+    }
+  }
+}
+
+// The neck as a chain of overlapping beads, then the head, which bobs forward on the beat
+part neck_and_head {
+  let beads = 24
+  let along = neck * bulk / beads
+  shape ball
+  shine 0.6
+  sharpness 0.5
+  repeat beads as i {
+    let t = i / (beads - 1)
+    let c = plumage
+    colour hsv(c.hue + shimmer * 0.6 * wave(t * 0.7 - time * 0.2), c.sat, c.val)
+    lay { grow mix(0.72, 0.4, t) * bulk }
+    forward along
+    pitch (42 + bob * kick * 2) / beads
+  }
+  pitch 42 + bob * kick * 0.3
+  head
+}
+
+part head {
+  // the head itself
+  colour plumage
+  shape ball
+  lay { grow (0.5, 0.5, 0.62) * bulk }
+
+  // the crown of plumes
+  branch {
+    move (0, 0.15 * bulk, -0.05 * bulk)
+    pitch -90 - crest_lean
+    shape tube
+    colour mix(crest_colour, black, 0.3)
+    repeat 7 as k {
+      branch {
+        yaw (k - 3) * 9
+        pitch (k - 3) * 2
+        let h = crest * bulk * (1 - abs(k - 3) * 0.06)
+        branch {
+          forward h * 0.5
+          lay { grow (0.025, 0.025, h) }
+        }
+        forward h
+        shape ball
+        colour crest_colour
+        shine 0.8
+        lay { grow (0.11, 0.05, 0.16) * bulk * clamp(crest * 2, 0, 1) }
+      }
+    }
+  }
+
+  // the beak
+  branch {
+    forward 0.32 * bulk
+    pitch 8
+    shape cone
+    colour hsv(35, 0.25, 0.6)
+    shine 0.6
+    lay { grow (0.14, 0.11, 0.36) * bulk }
+  }
+
+  // the flap of red skin under the beak
+  branch {
+    forward 0.22 * bulk
+    move (0, -0.2 * bulk, 0)
+    pitch 75 + bob * kick * 0.4
+    forward 0.25 * wattle * bulk
+    shape ball
+    colour hsv(355, 0.85, 0.8)
+    shine 0.4
+    lay { grow (0.14, 0.12, 0.55) * wattle * bulk }
+  }
+
+  // eyes, each in a patch of bare skin
+  symmetric x {
+    branch {
+      yaw 50
+      forward 0.24 * bulk
+      shape ball
+      colour face
+      shine 0.3
+      lay { grow (0.18, 0.12, 0.05) * bulk }
+      forward 0.02 * bulk
+      colour black
+      shine 1
+      sharpness 0.9
+      lay { grow 0.07 * bulk }
+    }
+  }
+}
+
+// A folded wing: overlapping long feathers lying back along the body
+part folded_wing {
+  shape ball
+  shine 0.35
+  repeat 6 as k {
+    let t = k / 5
+    branch {
+      move (0, 0.25 * bulk - t * 0.35 * bulk, 0.4 * bulk - t * 0.6 * bulk)
+      pitch -5 + t * 10
+      back (0.3 + t * 0.4) * bulk
+      let bar = clamp(wave(t * 2.5) * 2, 0, 1) * wing_bars
+      colour mix(mix(wing, mix(wing, black, 0.6), bar), primaries, smoothmix(0, 1, (t - 0.5) * 2.5))
+      lay { grow (0.2, 0.55 - t * 0.12, 1.2 + t * 0.45) * bulk }
+    }
+  }
+}
+
+// A leg that bends at the joint behind it, so the body can dip, and a foot with four toes
+part leg(hip_y) {
+  let hip = (0.45 * bulk, hip_y - 0.7 * bulk, 0)
+  let ankle = (0.5 * bulk, 0.16, 0.15)
+  let gap = ankle - hip
+  let d = length(gap)
+  let bone = 0.62 * height / 2
+  let bend = acos(clamp(d / (2 * bone), 0, 1))
+  shape tube
+  colour legs
+  shine 0.4
+  branch {
+    move hip
+    let tilt = atan2(gap.z, -gap.y)
+    yaw atan2(gap.x, -gap.y) // a small tilt outwards
+    pitch 90 - tilt
+    pitch bend
+    // the thigh is hidden in feathers, the back's colour lit a little by the breast's. Only the
+    // brightness is blended: blending the hues of two colours that are nearly opposite would make
+    // the colour flip round the wheel while the bird morphs
+    shape ball
+    colour hsv(mantle.hue, mantle.sat, mix(mantle.val, plumage.val, 0.25))
+    branch {
+      forward bone * 0.4
+      lay { grow (0.32, 0.32, bone) * bulk }
+    }
+    colour legs
+    forward bone
+    shape ball
+    lay { grow 0.14 * bulk }
+    pitch -2 * bend
+    shape tube
+    branch {
+      forward bone * 0.5
+      lay { grow (0.08 * bulk, 0.08 * bulk, bone) }
+    }
+  }
+  // the foot
+  branch {
+    move ankle
+    shape ball
+    colour legs
+    lay { grow 0.12 * bulk }
+    shape cone
+    pitch 8
+    repeat 3 as k {
+      branch {
+        yaw (k - 1) * 30
+        forward 0.28 * bulk
+        lay { grow (0.07, 0.05, 0.56) * bulk }
+      }
+    }
+    branch {
+      yaw 180
+      forward 0.15 * bulk
+      lay { grow (0.06, 0.05, 0.3) * bulk }
+    }
+  }
+}
+
+// A ring of grass blades round the feet, swaying with the music
+part grass_tuft {
+  shape cone
+  shine 0.2
+  repeat 80 as k {
+    branch {
+      // spread over a disc, not in a ring: the distance out uses another step than the angle
+      let a = k * 137.5
+      let r = 0.3 + 2 * sqrt(frac(k * 0.4142 + 0.13))
+      yaw a
+      forward r * bulk
+      pitch -90
+      pitch 12 * noise(k * 0.7) + 8 * wave(time / sway_time + k * 0.05) * mix(0.3, 1, playing)
+      let h = grass * (0.6 + 0.5 * frac(k * 0.371)) * bulk
+      colour hsv(95 + 25 * noise(k * 1.3), 0.7, 0.35 + 0.25 * frac(k * 0.29))
+      forward h * 0.5
+      lay { grow (0.08, 0.025, h) }
+    }
+  }
+}
+
+// How far the body's surface is from its middle, at size 1, in the direction turned round by
+// `round_by` and up by `up`: the body is an egg 1.5 wide, 1.6 high and 2.1 long
+function surface(round_by, up) {
+  let d = (sin(round_by) * cos(up) / 0.75, sin(up) / 0.8, cos(round_by) * cos(up) / 1.05)
+  return 1 / length(d)
+}
+
+// A quick rise on the beat, then a slower fall
+function hop(p) {
+  if p < 0.08 {
+    return smoothmix(0, 1, p / 0.08)
+  }
+  return exp(-(p - 0.08) * 5)
+}
+
+background {
+  gene glow = hsv(150, 0.6, 0.3) in hsv(0, 0, 0)..hsv(360, 1, 1) // the light behind the bird
+  gene sky = hsv(230, 0.7, 0.08) in hsv(0, 0, 0)..hsv(360, 1, 1) // the sky at the top
+  gene pulse = 0.25 in 0..1 // how much the light swells with the bass
+
+  let lit = hsv(glow.hue, glow.sat, glow.val * (1 + pulse * music.bass))
+  fill gradient(hsv(110, 0.5, 0.12), lit at 0.35, sky)
+}
+
+// Its own dance: the music carries it from one bird to the next, and the kicks bring it nearer.
+// It has no spin: the bird turns itself to show its fan (the show gene), always facing the front.
+dance {
+  gene strut = 0.5 in 0.1..1.5 // how many birds a second the music carries it through
+
+  morph follows music.mid speed strut settle 3
+  zoom follows music.bass_hit amount 0.3 settle 8
+}
+
+variant Snow {
+  under = hsv(40, 0.05, 0.88)
+  quill = hsv(40, 0.03, 1)
