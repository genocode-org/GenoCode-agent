+  flat_1 = hsv(323.3, 0.85, 0.03)
+  flat_2 = hsv(261.9, 0.72, 0.61)
+  flat_3 = hsv(186.8, 0.84, 0.49)
+  flat_4 = hsv(168.4, 0.55, 0.76)
