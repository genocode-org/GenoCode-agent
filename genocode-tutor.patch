+  upright_1 = hsv(138.6, 0.91, 1)
+  upright_2 = hsv(227.3, 0.54, 1)
+  upright_3 = hsv(291.8, 0.79, 1)
+  upright_4 = hsv(250.4, 0.66, 1)
+  upright_gaps = (0.3208, 0.3313, 0.7113)
+}
+
+variant member_5 {
+  twist = 22.5
+  twist_waves = 1.631
+  twist_start = 0.822
+  rise = -44
+  rise_waves = 1.43
+  rise_start = 0.2559
+  sway = -14
+  sway_waves = 1.329
+  sway_start = 0.5122
+  swell = (0.2999, 0.1816, 0.3011)
+  swell_waves = (14.21, 3.647, 7.402)
+  swell_start = (-0.9036, 0.535, 0.7646)
+  flat_1 = hsv(276.2, 0.81, 0.96)
+  flat_2 = hsv(247.6, 0.72, 0.66)
+  flat_3 = hsv(353, 0.85, 0.99)
+  flat_4 = hsv(87.7, 0.28, 0.91)
+  flat_gaps = (0.3527, 0.6461, 0.5309)
+  upright_1 = hsv(12.7, 0.98, 1)
+  upright_2 = hsv(282.3, 0.7, 1)
